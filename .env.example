ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY=  # GOOGLE_API_KEY 없을 때 폴백

# ── 모델(선택 · 미지정 시 아래 기본값) ──
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# HEAD_MODEL=claude-opus-4-8

# ── 실행 옵션(선택) ──
# MAX_TOKENS=1200
# WORKER_TIMEOUT_MS=30000
# HEAD_TIMEOUT_MS=60000

# ── AI 총괄로 평가 기록 보내기(선택 · 평가 도구용, 로컬 .env 에만) ──
AIFED_INGEST_URL=          # 받는 창구 주소(공개 저장소라 실제 값은 적지 않는다)
AIFED_INGEST_SECRET=       # 받는 창구 비밀값(적지 않는다)
AIFED_EVAL_TITLE=          # 이번 평가 한 줄의 제목(비우면 한 줄은 보내지 않고 호출 기록만 보낸다)
AIFED_EVAL_CONCLUSION=     # 한 줄 결론(비우면 「결론은 문서 참고」)
AIFED_EVAL_DOC=            # 평가 문서 링크(선택)
